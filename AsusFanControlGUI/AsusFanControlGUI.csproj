<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AsusFanControlGUI</RootNamespace>
    <AssemblyName>AsusFanControlGUI</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>propeller.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Exclude old-style infrastructure files that the SDK replaces -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Properties\Resources.Designer.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
  </ItemGroup>

  <!-- Keep the designer-generated Settings class; SDK-style projects don't
       auto-generate it, so we keep the existing file. -->
  <ItemGroup>
    <None Remove="Properties\Settings.settings" />
  </ItemGroup>

  <!-- Icon -->
  <ItemGroup>
    <Content Include="propeller.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsusFanControl\AsusFanControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <!-- Publish profile defaults used by `dotnet publish` -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>